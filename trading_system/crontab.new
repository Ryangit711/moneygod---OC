# ============================================================
# TRADING SYSTEM AUTOMATED JOBS
# ============================================================
# Timezone: America/Vancouver (PT)
# ============================================================

# Main daily pipeline - runs at 05:30 AM PT (before market open)
# This runs the full plumbing + catalyst + execution + journal
30 5 * * 1-5 cd /home/aryan/trading_system && /home/aryan/trading_venv/bin/python run_pilot.py --mode=full >> /home/aryan/trading_system/logs/cron_full.log 2>&1

# Quick plumbing check every 30 min during market hours (06:00-13:00 PT)
# This just checks liquidity and sends alerts if regime changes
0,30 6-13 * * 1-5 cd /home/aryan/trading_system && /home/aryan/trading_venv/bin/python run_pilot.py --mode=quick >> /home/aryan/trading_system/logs/cron_quick.log 2>&1

# Weekly state cleanup - Sunday 2 AM
0 2 * * 0 cd /home/aryan/trading_system && /home/aryan/trading_venv/bin/python cleanup_logs.py >> /home/aryan/trading_system/logs/cleanup.log 2>&1

